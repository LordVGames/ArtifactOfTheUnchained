		<PackageReference Include="Lordryn-DamageSourceForEnemies" Version="2.1.1" />

		<PackageReference Include="Lordryn-DamageSourceForEquipment" Version="2.0.2" />

		<PackageReference Include="MonoDetour" Version="0.7.16" />

		<PackageReference Include="MonoDetour.HookGen" Version="0.7.14" />

		<PackageReference Include="R2API.ContentManagement" Version="1.1.0" />

		<PackageReference Include="R2API.DamageType" Version="1.1.7" />
		<PackageReference Include="R2API.Language" Version="1.1.0" />
		<PackageReference Include="R2API.ProcType" Version="1.0.2" />
		<PackageReference Include="score-MiscFixes" Version="1.6.1" />
		<PackageReference Include="TeamMoonstorm-MoonstormSharedUtils" Version="2.6.2" />
		<PackageReference Include="TeamMoonstorm-Starstorm2" Version="0.6.46" Publicize="true" />

		<PackageReference Include="UnityEngine.Modules" Version="2021.3.45" IncludeAssets="compile" />
		<PackageReference Include="RiskOfRain2.GameLibs" Version="1.5.0-r.1" />
		<PackageReference Include="MMHOOK.RoR2" Version="2026.10.8" NoWarn="NU1701" />
